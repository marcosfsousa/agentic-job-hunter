ANTHROPIC_API_KEY=your_api_key

# The hand-scored corpus's posting bodies (#96), for live re-scoring only. They are
# gitignored, so they do not follow a `git worktree` — point this at one copy outside
# any checkout and every worktree finds it (#122). Unset, the default is
# tests/fixtures/scored_postings/ inside the checkout that is running.
# JOBSCOUT_FIXTURE_DIR=/path/to/scored_postings

# Re-evaluation threshold — jobs scoring strictly below this on first LLM pass get one
# extra call; the higher score is kept. Defaults to email_min_score from profile.yaml.
# REEVAL_BELOW=4

# Resend email delivery (optional — skipped if not set)
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev   # use sandbox, or your verified domain address
EMAIL_TO=you@example.com
