ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
ANTHROPIC_API_KEY=your_api_key

# Re-evaluation threshold — jobs scoring strictly below this on first LLM pass get one
# extra call; the higher score is kept. Defaults to email_min_score from profile.yaml.
# REEVAL_BELOW=4

# Resend email delivery (optional — skipped if not set)
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev   # use sandbox, or your verified domain address
EMAIL_TO=you@example.com

# Open Web Ninja (JSearch API) — optional; omit to disable JSearch source
OPEN_WEB_NINJA_API=ak_...
